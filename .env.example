# ============================================
# Achadinhos — Configuracao de ambiente
# ============================================

# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=debug

# --- Preview social (Open Graph) para links /r/{slug} usados em anuncios ---
# Sem isso, o Facebook/Instagram Ads pode exibir a imagem do destino final
# (ex: logo do canal de WhatsApp) em vez da arte da campanha.
# IMPORTANTE: precisa ser URL publica, sem token/query string — o crawler do
# Facebook nao consegue ler URLs assinadas. Recomendado 1200x630.
SOCIAL_PREVIEW_IMAGE_URL=
SOCIAL_PREVIEW_IMAGE_WIDTH=1200
SOCIAL_PREVIEW_IMAGE_HEIGHT=630
SOCIAL_PREVIEW_TITLE="Compensa, né?"
SOCIAL_PREVIEW_DESCRIPTION="As melhores ofertas, direto no seu WhatsApp."
# Link fixo do canal do WhatsApp, usado na rota /r/canal (anuncios "Siga o canal")
WHATSAPP_CHANNEL_URL=
# Pixel do Facebook disparado na pagina de redirect (PageView + ClickToChannel)
FACEBOOK_PIXEL_ID=

# --- Database (Supabase/PostgreSQL) ---
# Local via Docker: postgresql://achadinhos:achadinhos@localhost:5432/achadinhos?schema=public
# Supabase (rede sem IPv6): use o "Session pooler" (Project Settings > Database > Connection
# string > Session pooler), NAO a "Direct connection" (essa e IPv6-only e falha em muitas redes
# no Brasil). O Session pooler tem um limite baixo de conexoes simultaneas (ex: 15) — sempre
# defina connection_limit para o Prisma nao estourar esse teto.
DATABASE_URL="postgresql://achadinhos:achadinhos@localhost:5432/achadinhos?schema=public&connection_limit=5&pool_timeout=10"

# --- Redis (BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Discord ---
# Bot criado em discord.com/developers/applications > aba Bot > Reset Token.
# Nenhum Privileged Gateway Intent e necessario: so enviamos embeds e
# escutamos cliques em botao (Interaction), que nao exigem intent privilegiada.
# Permissoes do convite (OAuth2 > URL Generator, scope "bot"):
# Send Messages, Embed Links, Read Message History.
DISCORD_BOT_TOKEN=
# ID do canal onde os cards de aprovacao serao enviados. Para copiar:
# Configuracoes do Usuario > Avancado > Modo Desenvolvedor, depois botao
# direito no canal > Copiar ID do canal.
DISCORD_CHANNEL_ID=

# --- Shopee Affiliate Open API ---
# Credenciais em affiliate.shopee.com.br > Open API (AppID + Senha/Secret).
# Deixe em branco para rodar com o ShopeeMockAdapter (dados simulados).
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_API_BASE_URL=https://open-api.affiliate.shopee.com.br/graphql
# "mock" usa dados simulados; "live" usa a API real da Shopee
SHOPEE_MODE=mock

# --- Mercado Livre API (OAuth2 + PKCE) ---
# Cadastre o app em developers.mercadolivre.com.br (Gestao de aplicacoes).
MERCADO_LIVRE_CLIENT_ID=
MERCADO_LIVRE_CLIENT_SECRET=
# Precisa bater EXATAMENTE com o Redirect URI cadastrado no app do ML.
MERCADO_LIVRE_REDIRECT_URI=https://SEU-DOMINIO/marketplaces/mercado-livre/callback
MERCADO_LIVRE_API_BASE_URL=https://api.mercadolibre.com
MERCADO_LIVRE_AUTH_BASE_URL=https://auth.mercadolivre.com.br
# "mock" usa dados simulados; "live" usa a API real do ML
MERCADO_LIVRE_MODE=mock
# Parametros de link de afiliado — NAO existe API oficial para gerar link
# no ML. matt_word/matt_tool sao fixos por conta e vem da URL que aparece
# ao clicar "Compartilhar" no Portal de Afiliados (mercadolivre.com.br,
# Afiliados e criadores > Central).
MERCADO_LIVRE_MATT_WORD=
MERCADO_LIVRE_MATT_TOOL=

# --- Regras de negocio (podem ser sobrescritas sem alterar codigo) ---
MIN_REAL_DISCOUNT=0.10
PUBLISH_SCORE=70
HIGH_SCORE=85
AUTO_APPROVE_SCORE=88
HISTORY_TARGET_DAYS=90

# --- Polling tiers (quantidade de produtos e intervalo em minutos) ---
POLLING_HOT_SIZE=300
POLLING_HOT_INTERVAL_MIN=15
POLLING_WARM_SIZE=800
POLLING_WARM_INTERVAL_MIN=120
POLLING_COLD_INTERVAL_MIN=1440
